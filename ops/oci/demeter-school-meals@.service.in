[Unit]
Description=Demeter school meal collection (%i)
Wants=network-online.target
After=network-online.target
ConditionPathExists=@REPO_DIR@/scripts/run_cloud_school_meals.py

[Service]
Type=oneshot
User=@RUN_USER@
Group=@RUN_GROUP@
WorkingDirectory=@REPO_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Taipei
Environment=PATH=@RUNTIME_PATH@
RuntimeDirectory=demeter-school-meals
RuntimeDirectoryMode=0750
UMask=0077
ExecStart="@FLOCK@" -n -E 75 /run/demeter-school-meals/collector.lock "@PYTHON@" "@REPO_DIR@/scripts/run_cloud_school_meals.py" --mode %i --publish
TimeoutStartSec=4h
SuccessExitStatus=2 75
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
NoNewPrivileges=true
PrivateTmp=true

